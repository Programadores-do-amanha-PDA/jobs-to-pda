{
  "name": "community-jobs-extension",
  "version": "0.0.1",
  "description": "Firefox extension for Programadores do Amanhã community",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite build --watch",
    "dev:firefox": "web-ext run --source-dir=dist --firefox=flatpak:org.mozilla.firefox",
    "lint": "web-ext lint --source-dir=dist",
    "lint:source": "prettier --check .",
    "format": "prettier --write .",
    "build": "vite build && web-ext build --source-dir=dist -a dist --overwrite-dest",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@samrum/vite-plugin-web-extension": "^5.1.1",
    "@tsconfig/recommended": "^1.0.11",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.23",
    "@types/webextension-polyfill": "^0.10.7",
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.3",
    "vite": "^5.4.11",
    "web-ext": "^7.11.0",
    "webextension-polyfill": "^0.10.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "postcss": "^8.5.6",
    "string-strip-html": "^13.5.0",
    "tailwindcss": "^4.1.17"
  }
}
