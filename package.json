{
    "name": "community-jobs-extension",
    "version": "0.0.1",
    "description": "Web extension for Programadores do Amanhã community",
    "license": "MIT",
    "scripts": {
        "dev": "vite dev",
        "dev:chrome": "cross-env TARGET=chrome vite",
        "dev:firefox": "cross-env TARGET=firefox vite",
        "watch:chrome": "cross-env TARGET=chrome WATCH=true vite build --watch",
        "watch:firefox": "cross-env TARGET=firefox WATCH=true vite build --watch",
        "lint": "web-ext lint --source-dir=dist",
        "lint:source": "prettier --check .",
        "format": "prettier --write .",
        "build": "vite dev",
        "build:chrome": "cross-env TARGET=chrome vite build && cross-env TARGET=chrome tsx scripts/zip-after-build.ts",
        "build:firefox": "cross-env TARGET=firefox vite build && cross-env TARGET=firefox tsx scripts/zip-after-build.ts",
        "build:all": "yarn build:chrome && yarn build:firefox",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/css": "^0.14.1",
        "@eslint/js": "^9.39.1",
        "@eslint/json": "^0.14.0",
        "@eslint/markdown": "^7.5.1",
        "@tsconfig/recommended": "^1.0.11",
        "@types/node": "^24.10.1",
        "@types/react": "^18.2.74",
        "@types/react-dom": "^18.2.23",
        "@types/webextension-polyfill": "^0.10.7",
        "@vitejs/plugin-react": "^4.3.4",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^16.5.0",
        "husky": "^9.0.11",
        "jiti": "^2.6.1",
        "lint-staged": "^15.2.2",
        "prettier": "3.2.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tslib": "^2.8.1",
        "tsx": "^4.20.6",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.4.3",
        "typescript-eslint": "^8.46.4",
        "vite": "^5.4.11",
        "vite-plugin-web-extension": "^4.5.0",
        "web-ext": "^7.11.0",
        "webextension-polyfill": "^0.10.0",
        "zip-a-folder": "^3.1.9"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-slider": "^1.3.6",
        "@radix-ui/react-slot": "^1.2.4",
        "@supabase/supabase-js": "^2.81.1",
        "@tabler/icons-react": "^3.35.0",
        "@tailwindcss/postcss": "^4.1.17",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "jwt-decode": "^4.0.0",
        "lucide-react": "^0.555.0",
        "next-themes": "^0.4.6",
        "postcss": "^8.5.6",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.66.0",
        "react-router": "^7.9.6",
        "react-router-dom": "^7.9.6",
        "sonner": "^2.0.7",
        "string-strip-html": "^13.5.0",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.17",
        "zod": "^4.1.12",
        "zustand": "^5.0.8"
    }
}
