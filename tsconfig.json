{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/",
    "lib": ["ES2015", "DOM"],
    "jsx": "react",
    "sourceMap": true,
    "noImplicitAny": true,
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": "src",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*"]
}
